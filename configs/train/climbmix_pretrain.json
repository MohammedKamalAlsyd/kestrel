{
  "model_config_path": "configs/model/kestrel_350m_dense.json",
  "dataset_repo": "karpathy/climbmix-400b-shuffle",
  "dataset_split": "train",
  "text_field": "text",
  "shuffle_buffer_size": 2048,
  "seq_len": 2048,
  "val_eval_batches": 16,
  "micro_batch_size": 4,
  "grad_accum_steps": 8,
  "max_steps": 5000,
  "optimizer_type": "muon_adamw",
  "muon_lr": 0.02,
  "muon_momentum": 0.95,
  "muon_nesterov": true,
  "muon_weight_decay": 0.01,
  "muon_ns_steps": 5,
  "muon_adjust_lr_fn": null,
  "adamw_lr": 0.0003,
  "adamw_betas": [0.9, 0.95],
  "adamw_eps": 1e-08,
  "adamw_weight_decay": 0.1,
  "max_grad_norm": 1.0,
  "lr_schedule": "wsd",
  "warmup_steps": 200,
  "decay_steps": 500,
  "wsd_decay_type": "cosine",
  "min_lr_ratio": 0.1,
  "z_loss_weight": 0.0001,
  "aux_loss_weight": 1.0,
  "mtp_loss_weight": 0.3,
  "precision": "fp16",
  "log_interval": 25,
  "eval_interval": 250,
  "save_interval": 1000,
  "output_dir": "artifacts/checkpoints",
  "seed": 42,
  "tracking": {
    "enabled": true,
    "dagshub_repo": "MohammedKamalAlsyd/kestrel",
    "experiment_name": "kestrel",
    "stage": "stage2_bakeoff",
    "log_model_to_mlflow": false,
    "push_to_hub": true,
    "export_github_snapshot": true,
    "experiments_dir": "experiments"
  }
}
